DATABASE_URL="file:./dev.db"

# Backup (npm run backup) — grava uma cópia do banco dev.db.
# BACKUP_LOCAL_DIR: pasta local para guardar os backups (padrão: ./backups).
# BACKUP_ONEDRIVE_DIR: opcional — pasta sincronizada pelo OneDrive; uma cópia
# do backup é gravada ali e o próprio OneDrive envia para a nuvem.
# BACKUP_RETENCAO_DIAS: quantos dias manter backups antigos (padrão: 30).
# BACKUP_LOCAL_DIR="./backups"
# BACKUP_ONEDRIVE_DIR="/Users/seu-usuario/Library/CloudStorage/OneDrive-Pessoal/Finanças/Backups"
# BACKUP_RETENCAO_DIAS=30
